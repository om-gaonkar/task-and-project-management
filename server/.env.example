NODE_ENV=development
PORT=5000

# Comma-separated list of exact browser origins allowed to call the API with credentials.
# Wildcards are rejected on purpose.
CLIENT_URL=http://localhost:5173

# Plain local MongoDB. If you use the docker-compose replica set, append
# ?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27017/productivity_workspace

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# false for local dev. Behind a reverse proxy set the number of proxy hops (for example 1).
TRUST_PROXY=false

# --- Authentication (phase 2) ---
# Two different secrets, each at least 32 characters. Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Lifetimes. The access token is short; the refresh token slides (a new one on every refresh),
# and SESSION_MAX_AGE_DAYS is the hard cap after which the person must sign in again.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30

# Refresh-token cookie. Defaults: COOKIE_SECURE=true in production, false otherwise.
#
# Same-site deployment (recommended), for example app.example.com + api.example.com:
#   COOKIE_SAME_SITE=lax
# Different registrable domains, for example myapp.vercel.app + myapi.onrender.com:
#   COOKIE_SAME_SITE=none (requires COOKIE_SECURE=true)
# Safari and some other browsers block third-party cookies entirely, so sign-in will not
# persist there with the cross-site setup. Prefer one shared parent domain.
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false

# --- Google sign-in (optional: set all three or none) ---
# Create an OAuth client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must equal GOOGLE_CALLBACK_URL exactly. The callback is served by the API,
# not the client: http://localhost:5000/api/v1/auth/google/callback in development.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- Added in later phases (not read yet) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=productivity-workspace
